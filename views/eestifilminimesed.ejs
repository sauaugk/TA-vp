<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Eesti filmiinimesed</title>
</head>
<body>
	<h1>Eesti filmiinimesed</h1>
	<ul>
		<li><a href="/eestifilm">Tagasi filmi pealehele</a></li>
		<li><a href="/eestifilm/inimesed_add">Lisa Eesti filmiinimesi</a></li>
	</ul>
	<hr>
	<% if (personList.length > 0) { %>
		<ul>
			<% personList.forEach(person => { %>
				<li>
					<%= person.first_name %> <%= person.last_name %>,
					sündinud <%= person.born ? new Date(person.born).toLocaleDateString('et-EE') : '' %>
					<% if (person.deceased) { %>
						, surnud <%= new Date(person.deceased).toLocaleDateString('et-EE') %>
					<% } %>
				</li>
			<% }) %>
		</ul>
	<% } else { %>
		<p>Ühtegi inimest ei leitud.</p>
	<% } %>
</body>
</html>