<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Ameti lisamine</title>
</head>
<body>
	<h1>Lisa uus amet</h1>
	<ul>
		<li><a href="/eestifilm">Tagasi filmi pealehele</a></li>
	</ul>
	<hr>

	<% if (notice) { %>
		<p><strong><%= notice %></strong></p>
	<% } %>

	<form method="POST" action="/eestifilm/ametid_add">
		<label for="positionNameInput">Ameti nimetus:</label><br>
		<input type="text" name="positionNameInput" id="positionNameInput" value="<%= positionName || '' %>"><br>
		<% if (errors.positionName) { %> <span style="color:red;"><%= errors.positionName %></span><br> <% } %>
		<br>

		<label for="descriptionInput">Kirjeldus:</label><br>
		<textarea name="descriptionInput" id="descriptionInput" rows="4" cols="40"><%= description || '' %></textarea><br>
		<br>

		<button type="submit">Salvesta amet</button>
	</form>
</body>
</html>