<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Filmiinimese lisamine</title>
</head>
<body>
	<h1>Lisa Eesti filmiinimene</h1>
	<ul>
		<li><a href="/eestifilm">Tagasi filmi pealehele</a></li>
	</ul>
	<hr>

	<% if (notice) { %>
		<p><strong><%= notice %></strong></p>
	<% } %>

	<form method="POST" action="/eestifilm/inimesed_add">
		<label for="firstNameInput">Eesnimi:</label><br>
		<input type="text" name="firstNameInput" id="firstNameInput" value="<%= firstName || '' %>"><br><br>

		<label for="lastNameInput">Perekonnanimi:</label><br>
		<input type="text" name="lastNameInput" id="lastNameInput" value="<%= lastName || '' %>"><br><br>

		<label for="bornInput">Sünnikuupäev:</label><br>
		<input type="date" name="bornInput" id="bornInput" value="<%= born || '' %>"><br><br>

		<label for="deceasedInput">Surmakuupäev:</label><br>
		<input type="date" name="deceasedInput" id="deceasedInput" value="<%= deceased || '' %>"><br><br>

		<button type="submit">Salvesta</button>
	</form>
</body>
</html>